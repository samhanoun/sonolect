      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/sync/**",
        "$TURBO_ROOT$/apps/mobile/src/**",
        "$TURBO_ROOT$/services/sync-service/src/**",
        "$TURBO_ROOT$/packages/sync-core/src/**"
