{
  "name": "@sonolect/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "sonolect-build-service",
    "start": "node dist/index.js",
