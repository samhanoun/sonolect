    "@sonolect/service-kit": "workspace:*",
    "@sonolect/types": "workspace:*",
    "@sonolect/validation": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sonolect/service-build": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
