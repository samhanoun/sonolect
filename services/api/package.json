{
  "name": "@sonolect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "sonolect-build-service",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts && tsx src/auth.smoke.ts && tsx src/routes.smoke.ts && tsx src/audio-jobs.smoke.ts && tsx src/local-voice-transcript.e2e.smoke.ts && tsx src/transcript-persistence.smoke.ts && tsx src/ai-routes.smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@google-cloud/speech": "^7.0.0",
    "@google-cloud/vertexai": "^1.9.0",
    "@sonolect/config": "workspace:*",
    "@sonolect/types": "workspace:*",
    "@sonolect/validation": "workspace:*",
    "fastify": "^5.12.8",
    "jose": "6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sonolect/service-build": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
