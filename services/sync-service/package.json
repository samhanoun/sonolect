{
  "name": "@sonolect/sync-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "sonolect-build-service",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:firestore": "tsx --test src/firestore.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@google-cloud/firestore": "9.4.1",
    "@sonolect/service-kit": "workspace:*",
    "@sonolect/sync-core": "workspace:*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@sonolect/service-build": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
