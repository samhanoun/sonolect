rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    // Every part stays a boolean, so a user with no member document is
    // denied instead of failing on a role that is not there.
    function hasTenantRole(tenantId, roles) {
      return signedIn()
        && exists(memberPath(tenantId))
        && get(memberPath(tenantId)).data.role in roles;
    }

    function isTenantMember(tenantId) {
      return hasTenantRole(tenantId, ['owner', 'admin', 'member']);
    }

    function isTenantAdmin(tenantId) {
      return hasTenantRole(tenantId, ['owner', 'admin']);
    }

    function isTenantOwner(tenantId) {
      return hasTenantRole(tenantId, ['owner']);
    }

    // Admins give the admin and member roles; only an owner makes an owner.
    function canGiveRole(tenantId, role) {
      return role in ['admin', 'member'] || (role == 'owner' && isTenantOwner(tenantId));
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTenantAdmin(tenantId)
        && (request.resource.data.ownerId == resource.data.ownerId || isTenantOwner(tenantId));
      allow delete: if isTenantOwner(tenantId);

      match /members/{userId} {
        allow read: if isTenantMember(tenantId);
        // The user who creates a tenant adds themself as its first owner, in
        // the same batch or right after.
        allow create: if (isOwner(userId)
            && request.resource.data.role == 'owner'
            && !exists(memberPath(tenantId))
            && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid)
          || (isTenantAdmin(tenantId) && canGiveRole(tenantId, request.resource.data.role));
        allow update: if isTenantAdmin(tenantId)
          && canGiveRole(tenantId, request.resource.data.role)
          && (resource.data.role != 'owner' || isTenantOwner(tenantId));
        allow delete: if isTenantAdmin(tenantId)
          && (resource.data.role != 'owner' || isTenantOwner(tenantId));
      }

      match /projects/{projectId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /transcripts/{transcriptId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /agentRuns/{runId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isTenantMember(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /billing/{document=**} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if false;
      }
    }

    match /publicConfig/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
