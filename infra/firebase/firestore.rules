rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function tenantRole(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
    }

    function isTenantMember(tenantId) {
      return tenantRole(tenantId) in ['owner', 'admin', 'member'];
    }

    function isTenantAdmin(tenantId) {
      return tenantRole(tenantId) in ['owner', 'admin'];
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTenantAdmin(tenantId);

      match /members/{userId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      match /projects/{projectId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /transcripts/{transcriptId} {
        allow read, write: if isTenantMember(tenantId);
      }

      match /agentRuns/{runId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isTenantMember(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /billing/{document=**} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if false;
      }
    }

    match /publicConfig/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
