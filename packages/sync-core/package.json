{
  "name": "@sonolect/sync-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted note sync shared by the Sonolect apps and the sync service.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-portable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
