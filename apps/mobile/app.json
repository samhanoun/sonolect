{
  "expo": {
    "name": "Sonolect",
    "slug": "sonolect",
    "scheme": "sonolect",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B120E",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.sonolect.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "fr"]
      }
    },
    "android": {
      "package": "com.sonolect.app",
      "permissions": ["RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B120E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "fr": "./locales/fr.json"
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      "expo-font",
      ["expo-localization", { "supportsRTL": false }],
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sonolect uses the microphone to turn your voice into text.",
          "speechRecognitionPermission": "Sonolect uses speech recognition to transcribe what you dictate."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "backgroundColor": "#0B120E"
        }
      ],
      "./plugins/withAsyncStorageSize",
      "./plugins/withDarkAndroidTheme",
      "./plugins/withReleaseLogStripping",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    }
  }
}
