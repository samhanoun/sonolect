{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@sonolect/types": ["../../packages/types/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
