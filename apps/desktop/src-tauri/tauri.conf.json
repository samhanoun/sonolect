{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonolect",
  "version": "0.1.0",
  "identifier": "com.sonolect.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sonolect",
        "width": 1200,
        "height": 800
      },
      {
        "label": "recorder",
        "url": "index.html?window=recorder",
        "title": "Sonolect Recorder",
        "width": 320,
        "height": 80,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "center": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQkM1MEZFMzRENUIxOQpSV1FaVzAzakQ4VXJBMzVPVTZJaXcrWE9IU2Vhb0ZjM1QzMEJjWitqNEZJelJrYm1ZTTFWTzVDdQo=",
      "endpoints": [
        "https://github.com/samhanoun/sonolect/releases/latest/download/latest.json"
      ]
    }
  }
}
