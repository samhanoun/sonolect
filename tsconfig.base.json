{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@sonolect/types": ["./packages/types/src/index.ts"],
      "@sonolect/validation": ["./packages/validation/src/index.ts"],
      "@sonolect/config": ["./packages/config/src/index.ts"],
      "@sonolect/prompts": ["./packages/prompts/src/index.ts"],
      "@sonolect/sdk": ["./packages/sdk/src/index.ts"],
      "@sonolect/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
