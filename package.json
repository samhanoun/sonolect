{
  "name": "sonolect",
  "private": true,
  "version": "0.1.0",
  "description": "Sonolect — Speak. Refine. Act.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:release-readiness": "node --test scripts/release-readiness.test.mjs",
    "release:dry-run": "pnpm test:release-readiness",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "postcss": ">=8.5.10",
      "tar": ">=7.5.19",
      "uuid": ">=14.0.0",
      "shell-quote": ">=1.11.0",
      "websocket-driver": ">=0.7.5"
    }
  }
}
