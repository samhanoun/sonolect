{
  "name": "sonolect",
  "private": true,
  "version": "0.1.0",
  "description": "Sonolect — Speak. Refine. Act.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:release-readiness": "node --test scripts/release-readiness.test.mjs",
    "release:dry-run": "pnpm test:release-readiness",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.9.12",
      "postcss": ">=8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7",
      "@babel/core@<7.29.6": "^7.29.6",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "^1.14.5",
      "tar": ">=7.5.21",
      "uuid": ">=14.0.0",
      "shell-quote": ">=1.11.0",
      "websocket-driver@<0.7.5": "^0.7.5",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "protobufjs@>=7.0.0 <7.6.5": "^7.6.5",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@<1.1.21": "^1.1.21",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "@expo/plist>@xmldom/xmldom": "^0.8.13",
      "react-native-drawer-layout>react-native-reanimated": "-",
      "react-native-drawer-layout>react-native-gesture-handler": "-"
    }
  }
}
