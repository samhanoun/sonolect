NODE_ENV=development
GCP_PROJECT_ID=sonolect-dev
FIREBASE_PROJECT_ID=sonolect-dev
# Production always requires verified Firebase ID tokens, even if auth is set false.
# Explicit browser origins; no wildcards. Native provider requests do not use this API.
SONOLECT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost
GOOGLE_CLOUD_REGION=europe-west1
DATABASE_URL=postgresql://sonolect:sonolect@localhost:5432/sonolect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VERTEX_AI_LOCATION=europe-west1
AUDIO_TEMP_BUCKET=sonolect-dev-audio-temp
# Shared token(s) for the internal services (agent, audio, billing, sync, worker).
# Comma-separated, 32+ characters each. Required in production; when unset in
# development the services stay open and bind to 127.0.0.1 only.
SONOLECT_SERVICE_TOKENS=
# Optional model overrides for the agent service.
SONOLECT_OPENAI_MODEL=gpt-4o-mini
SONOLECT_ANTHROPIC_MODEL=claude-sonnet-5-5
